{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./workspace"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "./workspace"
      ]
    },
    "brewops": {
      "command": "./bin/brewops",
      "args": [
        "-db",
        "./workspace/brewops.db"
      ]
    },
    "netprobe": {
      "url": "http://localhost:8951/mcp"
    }
  }
}
