{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "./workspace"
      ]
    },
    "git": {
      "command": "uvx",
      "args": [
        "mcp-server-git",
        "--repository",
        "./workspace"
      ]
    },
    "brewops": {
      "command": "docker",
      "args": [
        "run",
        "-i",
        "--rm",
        "-v",
        "brewops-data:/data",
        "brewops-mcp:1.0.0"
      ]
    },
    "rrhh": {
      "command": "./peers/rrhh/.venv/bin/python",
      "args": [
        "./peers/rrhh/server.py"
      ],
      "env": [
        "HR_DB_PATH=./workspace/hr.db"
      ]
    },
    "hotel": {
      "command": "./.venv/bin/python",
      "args": [
        "-m",
        "hotel_mcp"
      ],
      "cwd": "./peers/hotel-mcp-server",
      "env": [
        "HOTEL_DB=./data/hotel-session.db",
        "HOTEL_EXPORT_DIR=./comprobantes"
      ]
    }
  }
}
